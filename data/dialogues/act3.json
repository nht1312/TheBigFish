  "start": "n1",
  "nodes": {
   "n1": {
    "speaker": "NARRATION",
    "text": "Có tiếng quát từ phía cái chòi tre.",
    "next": "n2"
   },
   "n2": {
    "speaker": "NPC_POND_OWNER",
    "text": "Ê! Hai đứa kia! Câu cá nhà ai đó?",
    "next": "n3"
   },
   "n3": {
    "speaker": "NARRATION",
    "text": "Cò quăng luôn cần, chạy thẳng về phía rào thủng. Bạn còn đứng đó, tay cầm con cá.",
    "next": "n4",
