 {
  "id": "DIALOGUE_FRIEND_INVITE",
  "tags": [
   "FRIEND",
   "STORY"
  ],
  "start": "n1",
  "nodes": {
   "n1": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Mày câu được đó. Mai tao dẫn đi chỗ này, cá ăn như điên.",
    "next": "n2"
   },
   "n2": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Phía nam hồ có cái ao. Qua chỗ rào thủng là tới.",
    "choices": [
     {
      "text": "Ao của ai vậy?",
      "next": "whose"
     },
     {
      "text": "Đi!",
      "next": "go",
      "effects": [
       {
        "type": "modify_relationship",
        "npc": "NPC_FISHING_FRIEND",
        "dim": "Friendship",
        "delta": 2
       }
      ]
     }
    ]
   },
   "whose": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Ao bỏ lâu rồi. Nghe nói ông chủ lên thành phố ở, không ai canh đâu.",
    "next": "go"
   },
   "go": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Tao ra đó trước. Chỗ rào thủng có bụi cỏ che, vạch ra là thấy."
   }
  },
  "end_effects": [
   {
    "type": "set_flag",
    "key": "POND_INVITED"
   },
   {
    "type": "message",
    "text": "Chỗ rào thủng phía nam hồ...",
    "style": "thought",
    "delay": 0.8
   }
  ]
 },
 {
