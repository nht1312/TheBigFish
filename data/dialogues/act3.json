        "delta": 3
       },
       {
        "type": "add_memory",
        "npc": "NPC_POND_OWNER",
        "memory": "PLAYER_APOLOGIZED"
       }
      ]
     },
     {
      "text": "Bạn con rủ. Con không biết gì hết.",
      "next": "blame",
      "effects": [
       {
        "type": "set_var",
        "key": "pond.fine",
        "value": "50"
       },
       {
        "type": "set_flag",
        "key": "BLAMED_FRIEND"
       }
      ]
     },
     {
      "text": "(Bỏ chạy)",
      "next": "run",
      "effects": [
       {
        "type": "set_var",
        "key": "pond.fine",
        "value": "80"
       },
       {
        "type": "set_flag",
