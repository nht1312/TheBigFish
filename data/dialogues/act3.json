  "start": "n1",
  "nodes": {
   "n1": {
    "speaker": "NARRATION",
    "text": "Một đứa trạc tuổi bạn ngồi trên cái xô úp ngược, cần câu kẹp giữa hai đầu gối.",
    "next": "n2"
   },
   "n2": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Cần tay ba mét sáu hả? Tao cũng có một cây y chang.",
    "choices": [
     {
      "text": "Mới mua. Dành dụm mấy bữa mới đủ.",
      "next": "saved",
      "effects": [
       {
        "type": "modify_relationship",
        "npc": "NPC_FISHING_FRIEND",
        "dim": "Respect",
        "delta": 2
       }
      ]
     },
     {
      "text": "Mày câu ở đây lâu chưa?",
      "next": "long"
     }
    ]
   },
   "saved": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Giỏi. Cây của tao xin tiền ba tao đó.",
    "next": "name"
   },
   "long": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Từ hồi lớp sáu. Hồ này tao thuộc từng gốc cây.",
    "next": "name"
   },
   "name": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Tao tên Cò. Ốm nhom nên tụi nó kêu vậy.",
    "next": "sit"
   },
   "sit": {
    "speaker": "NPC_FISHING_FRIEND",
    "text": "Ngồi đây câu chung nè. Hai đứa quăng gần nhau, cá tụ về đông hơn.",
    "next": "tip"
   },
   "tip": {
    "speaker": "NARRATION",
    "text": "Cò xích qua một bên, chừa chỗ cho bạn."
   }
  },
  "end_effects": [
   {
    "type": "modify_relationship",
    "npc": "NPC_FISHING_FRIEND",
    "dim": "Familiarity",
    "delta": 5
   },
   {
    "type": "add_memory",
    "npc": "NPC_FISHING_FRIEND",
