      "type": "set_flag",
      "key": "FRIEND_RAN"
     }
    ]
   },
   "n4": {
    "speaker": "NPC_POND_OWNER",
    "text": "Ao này chú nuôi, bỏ tiền mua cá giống. Câu vầy là ăn trộm, biết không?",
