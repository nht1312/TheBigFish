       },
       {
        "type": "modify_relationship",
        "npc": "NPC_POND_OWNER",
        "dim": "Respect",
        "delta": -3
       }
      ]
     }
    ]
   },
   "sorry": {
    "speaker": "NPC_POND_OWNER",
    "text": "Không biết... Rào thì thủng, bảng thì ngã. Chú cũng có lỗi một phần.",
    "next": "keep"
   },
   "blame": {
    "speaker": "NPC_POND_OWNER",
    "text": "Rủ thì cũng tự đi bằng chân mình. Đứa kia chạy rồi, còn mình con thì con chịu.",
    "next": "keep"
   },
   "keep": {
    "speaker": "NPC_POND_OWNER",
    "text": "Cần với cá chú giữ. Muốn lấy lại cần thì mang năm chục ngàn ra cổng ao mà chuộc."
   },
   "run": {
    "speaker": "NARRATION",
    "text": "Chưa được mấy bước thì bị nắm cổ áo lôi lại.",
    "next": "run2"
   },
   "run2": {
    "speaker": "NPC_POND_OWNER",
    "text": "Chạy hả? Nhà ở đâu? Chú biết mẹ mày đó, xóm đầu chợ chứ gì.",
    "next": "run3"
   },
   "run3": {
    "speaker": "NPC_POND_OWNER",
    "text": "Cần chú giữ. Tám chục ngàn, ra cổng ao mà chuộc. Để chú gọi cho mẹ mày luôn."
   }
